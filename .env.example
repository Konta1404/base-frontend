# Copy to .env and adjust. Read at runtime by the Next.js server (never exposed to the browser).

# Backend API base URL, as reachable from the Next.js server.
API_URL=http://localhost:4000
# Backend URL used by `docker compose up` (dev). Defaults to the bundled mock API.
# DOCKER_API_URL=http://host.docker.internal:8080

# Public URL of this frontend (used for OAuth redirect URIs).
APP_URL=http://localhost:3000

# Force Secure cookies on/off. Defaults to true when APP_URL is https.
# COOKIE_SECURE=true

# Google sign-in (optional). The button only appears when both are set.
# Authorized redirect URI in Google Cloud Console: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
